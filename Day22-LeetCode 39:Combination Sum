class Solution {
public:
    vector<vector<int>> ans;

    void dfs(int idx, int target, vector<int>& cur,
             vector<int>& candidates) {

        if (target == 0) {
            ans.push_back(cur);
            return;
        }

        for (int i = idx; i < candidates.size(); i++) {
            if (candidates[i] > target)
                continue;

            cur.push_back(candidates[i]);
            dfs(i, target - candidates[i], cur, candidates);
            cur.pop_back();
        }
    }

    vector<vector<int>> combinationSum(vector<int>& candidates,
                                       int target) {
        vector<int> cur;
        dfs(0, target, cur, candidates);
        return ans;
    }
};
