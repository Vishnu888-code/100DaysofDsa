class Solution {
public:
    vector<vector<int>> updateMatrix(vector<vector<int>>& mat) {
        int m = mat.size(), n = mat[0].size();
        queue<pair<int,int>> q;

        for (int i = 0; i < m; i++)
            for (int j = 0; j < n; j++)
                if (mat[i][j] == 0) q.push({i, j});
                else mat[i][j] = -1;

        int d[5] = {1, 0, -1, 0, 1};

        while (!q.empty()) {
            auto [x, y] = q.front();
            q.pop();

            for (int k = 0; k < 4; k++) {
                int a = x + d[k], b = y + d[k + 1];

                if (a >= 0 && a < m && b >= 0 && b < n && mat[a][b] == -1) {
                    mat[a][b] = mat[x][y] + 1;
                    q.push({a, b});
                }
            }
        }

        return mat;
    }
};
