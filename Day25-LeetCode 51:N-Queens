class Solution {
public:
    vector<vector<string>> ans;

    void solve(int row, vector<string>& board,
               vector<int>& col, vector<int>& d1, vector<int>& d2) {

        int n = board.size();

        if (row == n) {
            ans.push_back(board);
            return;
        }

        for (int c = 0; c < n; c++) {
            if (col[c] || d1[row + c] || d2[row - c + n - 1])
                continue;

            board[row][c] = 'Q';
            col[c] = d1[row + c] = d2[row - c + n - 1] = 1;

            solve(row + 1, board, col, d1, d2);

            board[row][c] = '.';
            col[c] = d1[row + c] = d2[row - c + n - 1] = 0;
        }
    }

    vector<vector<string>> solveNQueens(int n) {
        vector<string> board(n, string(n, '.'));
        vector<int> col(n), d1(2 * n), d2(2 * n);

        solve(0, board, col, d1, d2);
        return ans;
    }
};
