class Solution {
public:
    bool isNStraightHand(vector<int>& hand, int groupSize) {
        if (hand.size() % groupSize) return false;

        map<int, int> mp;
        for (int x : hand) mp[x]++;

        for (auto &[x, cnt] : mp) {
            while (mp[x] > 0) {
                for (int i = 0; i < groupSize; i++) {
                    if (mp[x + i] == 0) return false;
                    mp[x + i]--;
                }
            }
        }

        return true;
    }
};
