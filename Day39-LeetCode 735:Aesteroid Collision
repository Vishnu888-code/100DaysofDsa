class Solution {
public:
    vector<int> asteroidCollision(vector<int>& asteroids) {
        vector<int> st;

        for (int a : asteroids) {
            while (!st.empty() && st.back() > 0 && a < 0 && st.back() < -a)
                st.pop_back();

            if (st.empty() || st.back() < 0 || a > 0)
                st.push_back(a);
            else if (st.back() == -a)
                st.pop_back();
        }

        return st;
    }
};
