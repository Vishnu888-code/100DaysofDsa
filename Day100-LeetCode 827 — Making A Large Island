class Solution {
public:
    int n;
    
    int dfs(vector<vector<int>>& g, int r, int c, int id) {
        if(r < 0 || c < 0 || r >= n || c >= n || g[r][c] != 1)
            return 0;

        g[r][c] = id;
        return 1 + dfs(g,r+1,c,id) + dfs(g,r-1,c,id)
                 + dfs(g,r,c+1,id) + dfs(g,r,c-1,id);
    }

    int largestIsland(vector<vector<int>>& g) {
        n = g.size();
        unordered_map<int,int> area;
        int id = 2, ans = 0;

        for(int i = 0; i < n; i++)
            for(int j = 0; j < n; j++)
                if(g[i][j] == 1) {
                    area[id] = dfs(g,i,j,id);
                    ans = max(ans, area[id++]);
                }

        for(int i = 0; i < n; i++) {
            for(int j = 0; j < n; j++) {
                if(g[i][j] != 0) continue;

                set<int> s;
                if(i) s.insert(g[i-1][j]);
                if(i+1<n) s.insert(g[i+1][j]);
                if(j) s.insert(g[i][j-1]);
                if(j+1<n) s.insert(g[i][j+1]);

                int cur = 1;
                for(int x : s) cur += area[x];

                ans = max(ans, cur);
            }
        }

        return ans;
    }
};
