class Solution {
public:
    long long subArrayRanges(vector<int>& nums) {
        int n = nums.size();
        long long ans = 0;
        stack<int> st;

        // Sum of Maximums
        for (int i = 0; i <= n; i++) {
            while (!st.empty() && (i == n || nums[st.top()] < nums[i])) {
                int mid = st.top(); st.pop();
                int left = st.empty() ? -1 : st.top();
                ans += 1LL * nums[mid] * (mid - left) * (i - mid);
            }
            st.push(i);
        }

        while (!st.empty()) st.pop();

        // Sum of Minimums
        for (int i = 0; i <= n; i++) {
            while (!st.empty() && (i == n || nums[st.top()] > nums[i])) {
                int mid = st.top(); st.pop();
                int left = st.empty() ? -1 : st.top();
                ans -= 1LL * nums[mid] * (mid - left) * (i - mid);
            }
            st.push(i);
        }

        return ans;
    }
};
