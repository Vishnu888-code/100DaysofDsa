class Solution {
public:
    string removeKdigits(string num, int k) {
        string st;

        for (char c : num) {
            while (!st.empty() && k && st.back() > c) {
                st.pop_back();
                k--;
            }
            st.push_back(c);
        }

        while (k--)
            st.pop_back();

        int i = 0;
        while (i < st.size() && st[i] == '0')
            i++;

        st = st.substr(i);
        return st.empty() ? "0" : st;
    }
};
