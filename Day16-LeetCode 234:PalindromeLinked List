class Solution {
public:
    bool isPalindrome(ListNode* head) {
        ListNode *slow = head, *fast = head, *prev = NULL;

        while (fast && fast->next) {
            slow = slow->next;
            fast = fast->next->next;
        }

        while (slow) {
            ListNode* nxt = slow->next;
            slow->next = prev;
            prev = slow;
            slow = nxt;
        }

        while (prev) {
            if (head->val != prev->val)
                return false;
            head = head->next;
            prev = prev->next;
        }

        return true;
    }
};
