class Solution {
public:
    int maxScore(vector<int>& cardPoints, int k) {
        int n = cardPoints.size();
        int total = accumulate(cardPoints.begin(), cardPoints.end(), 0);

        if (k == n) return total;

        int window = n - k;
        int cur = 0;

        for (int i = 0; i < window; i++)
            cur += cardPoints[i];

        int mn = cur;

        for (int i = window; i < n; i++) {
            cur += cardPoints[i] - cardPoints[i - window];
            mn = min(mn, cur);
        }

        return total - mn;
    }
};
